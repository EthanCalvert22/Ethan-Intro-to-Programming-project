    {
      "id": "E11",
      "title": "Full five-day Brew & Byte playthrough with a hand-calculated result",
      "catalogue": "brew-and-byte",
      "arithmetic": [
        "Start: cash 10000.",
        "Day 1: buy 20 flat white (2400), 10 toastie (2000), 15 brownie (1050) -> cash 4550.",
        "  Prices at reference. Sold 10 FW (2800), 10 T (4500), 10 B (1800) = revenue 9100, COGS 1200+2000+700 = 3900, GP 5200. Cash 13650. Stock FW 10, T 0, B 5.",
        "Day 2: flat white 4.00 (demand 5), brownie 3.60 (exactly 2x, demand 5), buy 5 toastie (1000) -> cash 12650.",
        "  Sold 5 FW (2000), 5 T (2250), 5 B (1800) = revenue 6050, COGS 600+1000+350 = 1950, GP 4100. Cash 18700. Stock all 0 except FW 5.",
        "Day 3: toastie 9.01 (above 2x, demand 0), buy 4 toastie (800) -> cash 17900.",
        "  Sold 5 FW (2000), 0 T, 0 B = revenue 2000, COGS 600, GP 1400. Cash 19900. Stock T 4.",
        "Day 4: nothing sells (FW and B empty, toastie priced out). GP 0. Cash 19900.",
        "Day 5: toastie back to 4.50, brownie back to 1.80, buy 12 brownie (840) -> cash 19060.",
        "  Sold 4 T (1800), 10 B (1800) = revenue 3600, COGS 800+700 = 1500, GP 2100. Cash 22660. Stock B 2.",
        "Final: cash 22660, remaining stock 2 x 70 = 140, gain = 22660 + 140 - 10000 = 12800.",
        "Check: sum of daily GP = 5200 + 4100 + 1400 + 0 + 2100 = 12800.",
        "Check: cash change 12660 = sum of GP 12800 - cost of unsold stock 140."
      ],
      "steps": [
        { "do": "buy", "product": "flat-white", "quantity": 20, "expect": { "ok": true } },
        { "do": "buy", "product": "toastie", "quantity": 10, "expect": { "ok": true } },
        {
          "do": "buy",
          "product": "brownie",
          "quantity": 15,
          "expect": { "ok": true },
          "state": { "cashCents": 4550 }
        },
        {
          "do": "trade",
          "expect": { "ok": true },
          "day": {
            "day": 1,
            "totals": {
              "unitsSold": 30,
              "revenueCents": 9100,
              "cogsCents": 3900,
              "grossProfitCents": 5200
            },
            "cashAfterCents": 13650
          },
          "state": { "stock": { "flat-white": 10, "toastie": 0, "brownie": 5 } }
