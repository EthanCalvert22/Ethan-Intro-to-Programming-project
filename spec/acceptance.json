{
  "about": [
    "Machine-readable acceptance scenarios for Brew & Byte. tests/acceptance.test.ts runs every entry.",
    "All money is in integer euro cents (400 means €4.00).",
    "Each scenario starts from a fresh run of the named catalogue, optionally with 'start' overrides, then runs its steps in order.",
    "A step's 'expect' is either { ok: true } or { error: <kind> }. Rejected steps must leave the run unchanged and write nothing to storage; accepted steps write exactly one save.",
    "'state' lists the values to check after the step; stock and prices may list only some products.",
    "'day' checks the receipt of the day just traded; 'lines' are keyed by product id.",
    "The 'brief' catalogue reproduces the numbers used in the brief's acceptance criteria (an item costing €2 with a €4 reference price)."
  ],
  "catalogues": {
    "brief": [
      { "id": "lemonade", "name": "Lemonade", "unitCostCents": 200, "referencePriceCents": 400 },
      { "id": "cookie", "name": "Cookie", "unitCostCents": 100, "referencePriceCents": 150 },
      { "id": "muffin", "name": "Muffin", "unitCostCents": 50, "referencePriceCents": 125 }
    ]
  },
  "demandCases": [
    { "case": "A2", "referenceCents": 400, "priceCents": 400, "demand": 10 },
    { "case": "A2", "referenceCents": 400, "priceCents": 401, "demand": 5 },
    { "case": "A2", "referenceCents": 400, "priceCents": 800, "demand": 5 },
    { "case": "A2", "referenceCents": 400, "priceCents": 801, "demand": 0 },
    { "case": "below reference", "referenceCents": 400, "priceCents": 1, "demand": 10 },
    { "case": "odd reference, at 2x", "referenceCents": 150, "priceCents": 300, "demand": 5 },
    {
      "case": "odd reference, 1 cent over 2x",
      "referenceCents": 150,
      "priceCents": 301,
      "demand": 0
    },
    { "case": "odd cents reference, at 2x", "referenceCents": 175, "priceCents": 350, "demand": 5 },
    {
      "case": "odd cents reference, over 2x",
      "referenceCents": 175,
      "priceCents": 351,
      "demand": 0
    },
    { "case": "flat white reference", "referenceCents": 280, "priceCents": 280, "demand": 10 },
    { "case": "flat white 1 cent over", "referenceCents": 280, "priceCents": 281, "demand": 5 },
    { "case": "toastie at 2x", "referenceCents": 450, "priceCents": 900, "demand": 5 },
    { "case": "toastie over 2x", "referenceCents": 450, "priceCents": 901, "demand": 0 },
    { "case": "brownie far above", "referenceCents": 180, "priceCents": 100000, "demand": 0 }
  ],
  "priceInputCases": [
    { "text": "4", "cents": 400 },
    { "text": "4.01", "cents": 401 },
    { "text": "4.5", "cents": 450 },
    { "text": "4,50", "cents": 450 },
    { "text": "  4.50  ", "cents": 450 },
    { "text": "0.01", "cents": 1 },
    { "text": "1000", "cents": 100000 },
    { "text": "1000.00", "cents": 100000 },
    { "text": "007.10", "cents": 710 },
    { "text": "0", "error": "InvalidPrice" },
    { "text": "0.00", "error": "InvalidPrice" },
    { "text": "-1", "error": "InvalidPrice" },
    { "text": "-0.01", "error": "InvalidPrice" },
    { "text": "4.005", "error": "InvalidPrice" },
    { "text": "4,005", "error": "InvalidPrice" },
    { "text": "abc", "error": "InvalidPrice" },
    { "text": "1e2", "error": "InvalidPrice" },
    { "text": "", "error": "InvalidPrice" },
    { "text": "   ", "error": "InvalidPrice" },
    { "text": "4.", "error": "InvalidPrice" },
    { "text": ".50", "error": "InvalidPrice" },
    { "text": "€4.50", "error": "InvalidPrice" },
    { "text": "1,000.00", "error": "InvalidPrice" },
    { "text": "4 50", "error": "InvalidPrice" },
    { "text": "1000.01", "error": "InvalidPrice" },
    { "text": "99999999999999999999", "error": "InvalidPrice" },
    { "text": "Infinity", "error": "InvalidPrice" },
    { "text": "NaN", "error": "InvalidPrice" }
  ],
  "quantityInputCases": [
    { "text": "1", "quantity": 1 },
    { "text": "10", "quantity": 10 },
    { "text": " 7 ", "quantity": 7 },
    { "text": "007", "quantity": 7 },
    { "text": "1000", "quantity": 1000 },
    { "text": "0", "error": "InvalidQuantity" },
    { "text": "-3", "error": "InvalidQuantity" },
    { "text": "2.5", "error": "InvalidQuantity" },
    { "text": "2,5", "error": "InvalidQuantity" },
    { "text": "abc", "error": "InvalidQuantity" },
    { "text": "", "error": "InvalidQuantity" },
    { "text": "   ", "error": "InvalidQuantity" },
    { "text": "1e3", "error": "InvalidQuantity" },
    { "text": "1001", "error": "InvalidQuantity" },
    { "text": "99999999999999999999", "error": "InvalidQuantity" }
  ],
  "scenarios": [
    {
      "id": "A1",
      "title": "Purchase within budget",
      "catalogue": "brief",
      "steps": [
        {
          "do": "buy",
          "product": "lemonade",
          "quantity": 10,
          "expect": { "ok": true },
          "state": { "cashCents": 8000, "stock": { "lemonade": 10 } }
        },
        {
          "note": "41 more lemonades cost €82.00, more than the €80.00 left",
          "do": "buy",
          "product": "lemonade",
          "quantity": 41,
          "expect": { "error": "NotAffordable" },
          "state": { "cashCents": 8000, "stock": { "lemonade": 10 } }
        }
      ]
    },
    {
      "id": "A2",
      "title": "Zero or negative selling prices are rejected",
      "catalogue": "brief",
      "steps": [
        {
          "do": "setPrice",
          "product": "lemonade",
          "priceCents": 401,
          "expect": { "ok": true },
          "state": { "prices": { "lemonade": 401 } },
          "demand": { "lemonade": 5 }
        },
        {
          "do": "setPrice",
          "product": "lemonade",
          "priceCents": 0,
          "expect": { "error": "InvalidPrice" },
          "state": { "prices": { "lemonade": 401 } }
        },
        {
          "do": "setPrice",
          "product": "lemonade",
          "priceCents": -100,
          "expect": { "error": "InvalidPrice" }
        },
        {
          "do": "setPrice",
          "product": "lemonade",
          "priceCents": -1,
          "expect": { "error": "InvalidPrice" }
        },
        {
          "do": "setPriceText",
          "product": "lemonade",
          "text": "-0.01",
          "expect": { "error": "InvalidPrice" }
        },
        {
          "do": "setPriceText",
          "product": "lemonade",
          "text": "8.01",
          "expect": { "ok": true },
          "state": { "prices": { "lemonade": 801 } },
          "demand": { "lemonade": 0 }
        }
      ]
    },
    {
      "id": "A3",
      "title": "Reconcile a trading day",
      "catalogue": "brief",
      "start": { "cashCents": 8000, "stock": { "lemonade": 10, "cookie": 0, "muffin": 0 } },
      "steps": [
        {
          "do": "setPrice",
          "product": "lemonade",
          "priceCents": 400,
          "expect": { "ok": true }
        },
        {
          "do": "trade",
          "expect": { "ok": true },
          "day": {
            "day": 1,
            "lines": {
              "lemonade": {
                "priceCents": 400,
                "demand": 10,
                "unitsSold": 10,
                "revenueCents": 4000,
                "cogsCents": 2000,
                "grossProfitCents": 2000
              },
              "cookie": { "demand": 10, "unitsSold": 0, "revenueCents": 0 },
              "muffin": { "demand": 10, "unitsSold": 0, "revenueCents": 0 }
            },
            "totals": {
              "unitsSold": 10,
              "revenueCents": 4000,
              "cogsCents": 2000,
              "grossProfitCents": 2000
            },
            "cashAfterCents": 12000
          },
          "state": {
            "cashCents": 12000,
            "stock": { "lemonade": 0, "cookie": 0, "muffin": 0 },
            "currentDay": 2,
            "daysCompleted": 1
          }
        }
      ]
    },
    {
      "id": "A4",
      "title": "Stock limits sales",
      "catalogue": "brief",
      "start": { "cashCents": 9400, "stock": { "lemonade": 3 } },
      "steps": [
        {
          "do": "trade",
          "expect": { "ok": true },
          "day": { "lines": { "lemonade": { "demand": 10, "unitsSold": 3 } } },
          "state": { "stock": { "lemonade": 0 }, "cashCents": 10600 }
        },
        {
          "do": "trade",
          "expect": { "ok": true },
          "day": { "lines": { "lemonade": { "demand": 10, "unitsSold": 0 } } },
          "state": { "stock": { "lemonade": 0 }, "cashCents": 10600, "currentDay": 3 }
        }
      ]
    },
    {
      "id": "A5",
      "title": "Resume without replay",
      "catalogue": "brief",
      "steps": [
        { "do": "buy", "product": "lemonade", "quantity": 10, "expect": { "ok": true } },
        { "do": "buy", "product": "cookie", "quantity": 4, "expect": { "ok": true } },
        { "do": "setPrice", "product": "lemonade", "priceCents": 650, "expect": { "ok": true } },
        { "do": "setPrice", "product": "muffin", "priceCents": 99, "expect": { "ok": true } },
        {
          "do": "trade",
          "expect": { "ok": true },
          "state": {
            "cashCents": 11450,
            "stock": { "lemonade": 5, "cookie": 0 },
            "currentDay": 2,
            "daysCompleted": 1
          }
        },
        {
          "note": "Reopen the app: everything must be identical and the day must not be replayed",
          "do": "restart",
          "expect": { "ok": true },
          "state": {
            "cashCents": 11450,
            "stock": { "lemonade": 5, "cookie": 0, "muffin": 0 },
            "prices": { "lemonade": 650, "cookie": 150, "muffin": 99 },
            "currentDay": 2,
            "daysCompleted": 1
          }
        },
        {
          "do": "restart",
          "expect": { "ok": true },
          "state": { "cashCents": 11450, "daysCompleted": 1 }
        }
      ]
    },
    {
      "id": "A6",
      "title": "Complete and restart",
      "catalogue": "brief",
      "steps": [
        { "do": "buy", "product": "lemonade", "quantity": 12, "expect": { "ok": true } },
        { "do": "trade", "expect": { "ok": true } },
        { "do": "trade", "expect": { "ok": true } },
        { "do": "trade", "expect": { "ok": true } },
        { "do": "trade", "expect": { "ok": true } },
        {
          "do": "trade",
          "expect": { "ok": true },
          "state": {
            "status": "completed",
            "currentDay": 5,
            "daysCompleted": 5,
            "cashCents": 12400,
            "stock": { "lemonade": 0 }
          },
          "summary": {
            "finalCashCents": 12400,
            "remainingStockValueCents": 0,
            "gainLossCents": 2400
          }
        },
        {
          "do": "buy",
          "product": "cookie",
          "quantity": 1,
          "expect": { "error": "RunCompleted" }
        },
        {
          "do": "setPrice",
          "product": "cookie",
          "priceCents": 120,
          "expect": { "error": "RunCompleted" }
        },
        { "do": "trade", "expect": { "error": "RunCompleted" } },
        {
          "note": "The player cancels the confirmation: nothing changes",
          "do": "newRun",
          "confirm": false,
          "expect": { "ok": true },
          "state": { "status": "completed", "cashCents": 12400, "daysCompleted": 5 }
        },
        {
          "do": "newRun",
          "confirm": true,
          "expect": { "ok": true },
          "state": {
            "status": "in_progress",
            "cashCents": 10000,
            "stock": { "lemonade": 0, "cookie": 0, "muffin": 0 },
            "prices": { "lemonade": 400, "cookie": 150, "muffin": 125 },
            "currentDay": 1,
            "daysCompleted": 0
          }
        },
        {
          "do": "restart",
          "expect": { "ok": true },
          "state": { "status": "in_progress", "cashCents": 10000, "daysCompleted": 0 }
        }
      ]
    },
    {
